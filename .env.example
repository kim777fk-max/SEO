# OpenAI API Key (optional)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Claude API Key (optional)
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-your-claude-api-key-here

# Google Gemini API Key (optional)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# SPA Rendering Services (optional, for SPA mode)
# Choose ONE of the following:

# Option 1: ScrapingBee (recommended for beginners)
# Get your free API key from: https://www.scrapingbee.com/
# Free plan: 1,000 requests/month
SCRAPINGBEE_API_KEY=your-scrapingbee-api-key-here

# Option 2: Browserless.io
# Get your free token from: https://www.browserless.io/
# Free plan: 6 hours/month (~360 requests)
BROWSERLESS_TOKEN=your-browserless-token-here

# Note: At least one API key should be set for AI-powered suggestions.
# If no API keys are set, the app will use rule-based analysis as a fallback.
# For full SPA support, set either SCRAPINGBEE_API_KEY or BROWSERLESS_TOKEN.
